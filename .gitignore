/target/

# --- Legacy Gradle / Eclipse build output (kept so a stray old build never gets committed) ---
/.gradle/
/bin/
/build/
/log/

# --- IDE metadata ---
/.idea/
*.iml
/.classpath
/.project
/.settings/
/.vscode/*
!/.vscode/settings.json
!/.vscode/launch.json
!/.vscode/extensions.json

# --- Generated installer artifacts (regenerated by 'mvn -Pinstaller package') ---
/installer/dist/
/installer/jre/

# --- OS noise ---
Thumbs.db
.DS_Store
